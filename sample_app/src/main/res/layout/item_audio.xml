<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Concentric rings that grow outward from the avatar while this
         participant is speaking — sized bigger than the avatar so the rings
         have room to expand before fading out. -->
    <com.sample.videohub.audio.SonarRingView
        android:id="@+id/speaking_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="invisible"
        app:ringColor="#4CAF50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/outline_account_circle_24"
        app:tint="@color/gray"
        app:layout_constraintStart_toStartOf="@id/speaking_ring"
        app:layout_constraintEnd_toEndOf="@id/speaking_ring"
        app:layout_constraintTop_toTopOf="@id/speaking_ring"
        app:layout_constraintBottom_toBottomOf="@id/speaking_ring" />

    <TextView
        android:id="@+id/identity_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/speaking_ring"
        app:layout_constraintTop_toTopOf="@id/speaking_ring"
        app:layout_constraintBottom_toBottomOf="@id/speaking_ring"
        app:layout_constraintEnd_toStartOf="@id/img_audio" />

    <!-- LOCAL row: clickable self mute toggle. REMOTE row: passive mic-state badge. -->
    <ImageView
        android:id="@+id/img_audio"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:src="@drawable/outline_mic_24"
        app:tint="@color/white"
        app:layout_constraintEnd_toStartOf="@id/img_mute"
        app:layout_constraintTop_toTopOf="@id/speaking_ring"
        app:layout_constraintBottom_toBottomOf="@id/speaking_ring" />

    <!-- Remote-moderation controls: host-only, remote rows only. -->
    <ImageView
        android:id="@+id/img_mute"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:src="@drawable/outline_mic_off_24"
        android:visibility="gone"
        app:tint="@color/white"
        app:layout_constraintEnd_toStartOf="@id/img_kick"
        app:layout_constraintTop_toTopOf="@id/speaking_ring"
        app:layout_constraintBottom_toBottomOf="@id/speaking_ring" />

    <ImageView
        android:id="@+id/img_kick"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:src="@drawable/account_cancel_outline"
        android:visibility="gone"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/speaking_ring"
        app:layout_constraintBottom_toBottomOf="@id/speaking_ring" />

</androidx.constraintlayout.widget.ConstraintLayout>

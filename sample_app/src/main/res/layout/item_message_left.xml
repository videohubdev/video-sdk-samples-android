<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:id="@+id/leftRoot"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/ic_background_chat_left">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:text="title"/>

        <!-- Quoted original — only shown by ReplyMessageItem. -->
        <TextView
            android:id="@+id/tvQuoted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="280dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:paddingVertical="2dp"
            android:background="#332196F3"
            android:textSize="13sp"
            android:textColor="@color/gray"
            android:visibility="gone"
            tools:text="Alice: original message" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:padding="6dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="messsage"/>

        <TextView
            android:id="@+id/tvReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="❤️ 2 👍 1"/>

    </LinearLayout>

</LinearLayout>

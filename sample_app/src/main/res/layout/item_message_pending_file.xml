<?xml version="1.0" encoding="utf-8"?>
<!-- "Shadow" bubble shown the instant a file is picked, before upload even
     starts — always right-aligned (only the sender sees their own send in
     flight). Swapped for item_message_attachments_right once the real
     broadcast for it arrives (see ChatFragment.pendingLocalIdByFileId). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:orientation="vertical"
    android:gravity="end">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/ic_background_chat_right">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_insert_drive_file_24"
                app:tint="@color/white"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:minWidth="120dp">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="180dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="document.pdf"/>

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    tools:text="1.2 MB"/>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressDownload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="false"
            app:trackThickness="3dp"
            app:indicatorColor="@color/white"
            tools:progress="40"/>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1.3"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/outline_videocam_off_24"
                app:tint="#2196F3" />

            <dev.videohub.android.renderer.TextureViewRenderer
                android:id="@+id/renderer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/connection_quality"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/identity_bar_padding"
                android:layout_marginEnd="@dimen/identity_bar_padding"
                android:alpha="0.8"
                android:src="@drawable/wifi_strength_1"
                android:visibility="invisible"
                app:tint="#FF0000" />

            <ImageView
                android:id="@+id/speaking_indicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/speaker_indicator"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/camera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/outline_cameraswitch_24"
                android:visibility="visible" />

            <!-- Own-stream toggles: hidden by default, shown only by the
                 local-participant binder. -->
            <ImageView
                android:id="@+id/img_video"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/outline_videocam_24"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_audio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/outline_mic_24"
                android:visibility="gone" />

            <!-- Remote-moderation controls: hidden by default, shown only
                 for a REMOTE participant's row and only when the local
                 user is host (see StreamItem's isHost gating). -->
            <ImageView
                android:id="@+id/img_mute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/outline_mic_off_24"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_kick"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/account_cancel_outline"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/identity_bar"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="#80000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/mute_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/outline_mic_off_24"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/identity_bar"
            app:layout_constraintEnd_toEndOf="@id/identity_bar"
            app:layout_constraintTop_toTopOf="@id/identity_bar"
            app:tint="#BB0000" />

        <TextView
            android:id="@+id/identity_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@id/identity_bar"
            app:layout_constraintEnd_toStartOf="@id/mute_indicator"
            app:layout_constraintStart_toStartOf="@id/identity_bar"
            app:layout_constraintTop_toTopOf="@id/identity_bar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
